Write a C program to simulate: Deadlock Detection

#include <stdio.h>

int main() {
    int p, r, i, j, k;

    printf("Enter number of processes: ");
    scanf("%d", &p);

    printf("Enter number of resource types: ");
    scanf("%d", &r);

    int alloc[p][r], request[p][r], avail[r];
    int finish[p], safeSeq[p];

    printf("\nEnter Allocation Matrix:\n");
    for(i = 0; i < p; i++) {
        for(j = 0; j < r; j++) {
            scanf("%d", &alloc[i][j]);
        }
    }


    printf("\nEnter Request Matrix:\n");
    for(i = 0; i < p; i++) {
        for(j = 0; j < r; j++) {
            scanf("%d", &request[i][j]);
        }
    }


    printf("\nEnter Available Resources:\n");
    for(i = 0; i < r; i++) {
        scanf("%d", &avail[i]);
    }


    for(i = 0; i < p; i++) {
        finish[i] = 0;
    }

    int count = 0;

    while(count < p) {
        int found = 0;

        for(i = 0; i < p; i++) {

            if(finish[i] == 0) {


                for(j = 0; j < r; j++) {
                    if(request[i][j] > avail[j]) {
                        break;
                    }
                }


                if(j == r) {

                    for(k = 0; k < r; k++) {
                        avail[k] += alloc[i][k];
                    }

                    safeSeq[count++] = i;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }


        if(found == 0) {
            break;
        }
    }


    if(count == p) {
        printf("\nSystem is NOT in Deadlock.\n");
        printf("Safe Sequence: ");

        for(i = 0; i < p; i++) {
            printf("P%d ", safeSeq[i]);
        }
    }
    else {
        printf("\nSystem is in DEADLOCK.\n");
        printf("Deadlocked Processes: ");

        for(i = 0; i < p; i++) {
            if(finish[i] == 0) {
                printf("P%d ", i);
            }
        }
    }

    return 0;
}
