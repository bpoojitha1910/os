#include <stdio.h>

int main()
{
    int n, i, time = 0, remain, tq;
    int at[10], bt[10], rt[10];
    int wt = 0, tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    remain = n;

    printf("Enter Arrival Time and Burst Time:\n");
    for(i = 0; i < n; i++)
    {
        printf("P%d: ", i+1);
        scanf("%d %d", &at[i], &bt[i]);
        rt[i] = bt[i]; // remaining time //
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    printf("\nProcess\tTurnaround Time\tWaiting Time\n");

    while(remain != 0)
    {
        for(i = 0; i < n; i++)
        {
            if(rt[i] > 0 && at[i] <= time)
            {
                if(rt[i] > tq)
                {
                    time += tq;
                    rt[i] -= tq;
                }
                else
                {
                    time += rt[i];
                    int t = time - at[i]; // turnaround time //
                    int w = t - bt[i];    // waiting time //

                    tat += t;
                    wt += w;

                    printf("P%d\t\t%d\t\t%d\n", i+1, t, w);

                    rt[i] = 0;
                    remain--;
                }
            }
        }
    }

    printf("\nAverage Turnaround Time = %.2f", (float)tat/n);
    printf("\nAverage Waiting Time = %.2f\n", (float)wt/n);

    return 0;
}
