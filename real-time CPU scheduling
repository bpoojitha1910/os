#include <stdio.h>

typedef struct {
    int id, burst, period, remain;
} Process;

int main() {

    int n, t;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    Process p[n];

    for(int i = 0; i < n; i++) {

        p[i].id = i + 1;

        printf("Burst Time and Period of P%d: ", i + 1);
        scanf("%d%d", &p[i].burst, &p[i].period);

        p[i].remain = 0;
    }

    printf("\nRMS Scheduling:\n");

    for(t = 0; t < 20; t++) {

        for(int i = 0; i < n; i++)
            if(t % p[i].period == 0)
                p[i].remain = p[i].burst;

        int sel = -1, min = 999;

        for(int i = 0; i < n; i++) {

            if(p[i].remain > 0 && p[i].period < min) {
                min = p[i].period;
                sel = i;
            }
        }

        if(sel != -1) {
            printf("Time %d -> P%d\n", t, p[sel].id);
            p[sel].remain--;
        }
        else
            printf("Time %d -> IDLE\n", t);
    }

    return 0;
}
