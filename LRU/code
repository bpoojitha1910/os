#include <stdio.h>

int main() {
    int n, f, i, j, fault = 0;

    printf("Enter number of pages: ");
    scanf("%d", &n);
    int pages[n];

    printf("Enter page reference string:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    int frame[f], time[f];

    for(i = 0; i < f; i++) {
        frame[i] = -1;
        time[i] = 0;
    }

    for(i = 0; i < n; i++) {
        int found = 0;

        for(j = 0; j < f; j++) {
            if(frame[j] == pages[i]) {
                found = 1;
                time[j] = i;
            }
        }

        if(!found) {
            int lru = 0;
            for(j = 1; j < f; j++)
                if(time[j] < time[lru])
                    lru = j;

            frame[lru] = pages[i];
            time[lru] = i;
            fault++;
        }
    }

    printf("Page Faults = %d", fault);
    return 0;
}
