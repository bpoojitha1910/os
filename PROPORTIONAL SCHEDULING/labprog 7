Write a C program to simulate Real-Time CPU Scheduling algorithms:Proportional scheduling

#include <stdio.h>

struct Process
{
    int pid;
    int burstTime;
    int share;
    int allocated;
};

int main()
{
    int n, totalTime = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for (int i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        printf("\nEnter burst time for Process %d: ", p[i].pid);
        scanf("%d", &p[i].burstTime);

        printf("Enter proportional share (in %% ) for Process %d: ", p[i].pid);
        scanf("%d", &p[i].share);

        totalTime += p[i].burstTime;
    }

    printf("\nProportional Scheduling\n");


    for (int i = 0; i < n; i++)
    {
        p[i].allocated = (p[i].share * totalTime) / 100;


        if (p[i].allocated > p[i].burstTime)
            p[i].allocated = p[i].burstTime;
    }


    printf("\nPID\tBurst Time\tShare\tAllocated CPU Time\n");

    for (int i = 0; i < n; i++)
    {
        printf("%d\t%d\t\t%d%%\t%d\n",
               p[i].pid,
               p[i].burstTime,
               p[i].share,
               p[i].allocated);
    }

    return 0;
}
