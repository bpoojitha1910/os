#include <stdio.h>

int main() {
    int m, n, i, j;

    printf("Enter number of memory blocks: ");
    scanf("%d", &m);
    int block[m];

    printf("Enter block sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &n);
    int process[n], alloc[n];

    printf("Enter process sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &process[i]);

    for(i = 0; i < n; i++)
        alloc[i] = -1;

    for(i = 0; i < n; i++) {
        int worst = -1;

        for(j = 0; j < m; j++) {
            if(block[j] >= process[i]) {
                if(worst == -1 || block[j] > block[worst])
                    worst = j;
            }
        }

        if(worst != -1) {
            alloc[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nProcess\tBlock\n");
    for(i = 0; i < n; i++)
        printf("P%d\t%d\n", i + 1, alloc[i] + 1);

    return 0;
}
